# Azure AD app registration (permission Graph : Sites.Read.All ou Sites.Selected)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Site SharePoint a surveiller
SHAREPOINT_HOST=test.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/test

# Dossier (dans la racine du drive) qui contient les PDF bordereaux
SHAREPOINT_FOLDER=test

# Intervalle de polling en secondes
POLL_INTERVAL=30

# Dossier local ou les PDF telecharges atterrissent
INCOMING_DIR=./data/incoming
